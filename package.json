{
  "name": "vscode-character-card-v2-editor",
  "displayName": "Character card V2 editor",
  "description": "A Visual Studio Code extension for editing V2 character cards",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-character-card-v2-editor.helloWorld",
        "title": "Hello World"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "v2-editor",
          "title": "Character card V2 editor",
          "icon": "assets/character-card-v2-editor-view-container.svg"
        }
      ]
    },
    "views": {
      "v2-editor": [
        {
          "id": "v2-editor:cards",
          "name": "Cards"
        },
        {
          "id": "v2-editor:json",
          "name": "JSON"
        },
        {
          "id": "v2-editor:lorebooks",
          "name": "Lorebooks"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
